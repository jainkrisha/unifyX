# Database configuration
# DB path is fixed in code, not configurable via env, by design.

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production-use-strong-random-value
JWT_EXPIRY_MINUTES=60

# Admin API Key (for simplified auth during development)
# This will be replaced with JWT-based RBAC in production
ADMIN_API_KEY=change-me
